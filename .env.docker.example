# Copy this file to .env.docker and replace both password values before deployment.
FACE_DB_PASSWORD=replace-with-a-long-random-application-password
FACE_DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
FACE_IMAGE_TAG=local
FACE_BACKEND_PORT=8090
FACE_ADMIN_PORT=8081
FACE_CLIENT_PORT=8082
FACE_TECHNICIAN_PORT=8083
FACE_DB_POOL_MAX=20
FACE_DB_POOL_MIN=2
