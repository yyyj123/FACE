# Non-secret production settings. Create secret files under FACE_SECRET_DIR; never put secret values here.
FACE_DOMAIN=face.example.com
FACE_PUBLIC_ORIGIN=https://face.example.com
FACE_HTTP_PORT=80
FACE_HTTPS_PORT=443
FACE_PROMETHEUS_PORT=9090
FACE_IMAGE_TAG=sc9-production
FACE_SECRET_DIR=./secrets/production
FACE_ADAPTER_DIR=./prod/adapters/installed
FACE_CHANNEL_EVIDENCE_DIR=./channel-evidence/production
FACE_BACKUP_DIR=./backups/production
FACE_DB_POOL_MAX=20
FACE_DB_POOL_MIN=4
BUSINESS_MODE=SINGLE_SHOP
DEFAULT_SHOP_ID=1
OBJECT_STORAGE_BUCKET=face-production
OBJECT_STORAGE_PUBLIC_BASE_URL=https://face.example.com/objects
SMS_MODE=disabled
SMS_HTTP_ENDPOINT=
FACE_PROD_PAYMENT_CHANNEL=disabled
FACE_PROD_LOGISTICS_CHANNEL=disabled
FACE_SC6_FULFILLMENT_SCAN_MS=300000
