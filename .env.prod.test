# Synthetic SC9 acceptance configuration. Secrets are generated under .runtime and are not tracked.
FACE_DOMAIN=face.local
FACE_PUBLIC_ORIGIN=https://face.local:9443
FACE_HTTP_PORT=9080
FACE_HTTPS_PORT=9443
FACE_PROMETHEUS_PORT=19090
FACE_IMAGE_TAG=sc9-acceptance
FACE_SECRET_DIR=./.runtime/sc9-secrets
FACE_ADAPTER_DIR=./prod/adapters/installed
FACE_CHANNEL_EVIDENCE_DIR=./.runtime/sc9-channel-evidence
FACE_BACKUP_DIR=./backups/sc9-acceptance
FACE_DB_POOL_MAX=10
FACE_DB_POOL_MIN=2
BUSINESS_MODE=SINGLE_SHOP
DEFAULT_SHOP_ID=1
OBJECT_STORAGE_BUCKET=face-production
OBJECT_STORAGE_PUBLIC_BASE_URL=https://face.local:9443/objects
SMS_MODE=disabled
SMS_HTTP_ENDPOINT=
FACE_PROD_PAYMENT_CHANNEL=disabled
FACE_PROD_LOGISTICS_CHANNEL=disabled
FACE_SC6_FULFILLMENT_SCAN_MS=1000
FACE_SC9_ACCEPTANCE_SELF_SIGNED=true
